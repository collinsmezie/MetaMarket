# ─────────────────────────────────────────────────────────────────────────────
# MetaMarket configuration
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Every variable here is validated at boot by src/config/env.schema.ts; the app
# refuses to start with an invalid configuration rather than failing later.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Renders the Execution.md §3 stage logs as human-readable terminal blocks.
# Set false in production to emit newline-delimited JSON instead.
LOG_PRETTY=true

# ── Postgres ─────────────────────────────────────────────────────────────────
# Host port 5434 avoids colliding with a system Postgres on 5432.
POSTGRES_USER=metamarket
POSTGRES_PASSWORD=metamarket
POSTGRES_DB=metamarket
POSTGRES_PORT=5434
DATABASE_URL=postgresql://metamarket:metamarket@localhost:5434/metamarket?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
# Host port 6381 avoids colliding with a system Redis on 6379.
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# ── Object storage (MinIO in dev, S3 in production) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=metamarket-media
S3_ACCESS_KEY_ID=metamarket
S3_SECRET_ACCESS_KEY=metamarket-secret
S3_FORCE_PATH_STYLE=true

# ── LLM providers ────────────────────────────────────────────────────────────
# OpenAI is the primary provider. Gemini and Anthropic are automatic fallbacks
# (Execution.md §2.4); leaving their keys blank simply removes them from the
# fallback chain — the chain is not silently disabled.
OPENAI_API_KEY=
# Model pinned for the TDR v1.3 specialists (IDCE, CSRE, Enrichment, GPC, MCOS prompts); chat model, temperature 0.
LLM_SPECIALIST_MODEL=gpt-4o-2024-11-20
# P5/P6 naturalisation of multi-result replies (single results are composed deterministically).
ORCHESTRATOR_NATURALIZE_RESPONSES=true
OPENAI_MODEL=gpt-4o-2024-11-20
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the pgvector column dimension in prisma/schema.prisma.
# text-embedding-3-small = 1536, text-embedding-3-large = 3072.
EMBEDDING_DIMENSION=1536

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Resilience: max attempts per provider before failing over to the next one.
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_MS=30000
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_MS=60000

# ── Speech-to-text / OCR ─────────────────────────────────────────────────────
STT_PROVIDER=openai
STT_MODEL=whisper-1
STT_MIN_CONFIDENCE=0.55

# ── Web client ───────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call /channels/web/*. The web client is hosted
# separately, so it is always cross-origin. Empty disables browser access entirely —
# these routes start workflows and spend credits, so there is no '*' fallback.
WEB_CLIENT_ORIGINS=http://localhost:3000

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# From the Meta app dashboard → WhatsApp → API Setup.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta App Secret — used to verify the X-Hub-Signature-256 header on every webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0
# Reject webhooks whose HMAC signature fails. Keep true everywhere except when
# replaying captured fixtures locally.
WHATSAPP_VERIFY_SIGNATURE=true

# ── Twilio (SMS + Voice) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_FROM=

# ── Paystack (credits funding) ────────────────────────────────────────────────
# Dedicated Virtual Accounts: users fund their credit wallet by normal bank transfer.
# The secret key both authenticates API calls and verifies inbound webhook signatures.
# A/AAAA ordering for every outbound HTTP call. Hosts without a working IPv6 route still
# receive AAAA records for graph.facebook.com and time out connecting to them, which silently
# drops outbound WhatsApp messages. Set `verbatim` (Node's default) on a dual-stack host.
DNS_RESULT_ORDER=ipv4first

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_API_BASE=https://api.paystack.co
# Reject webhooks whose HMAC-SHA512 signature fails. Keep true outside fixture replay.
PAYSTACK_WEBHOOK_SIGNATURE_VERIFY=true
# Bank partner for dedicated virtual accounts. Leave blank to derive from the key mode —
# `test-bank` on an sk_test key, `wema-bank` on live. Paystack rejects the wrong one outright.
PAYSTACK_DVA_BANK=
# Naira per credit. Conversion floors, so this is also the minimum fundable amount.
NAIRA_PER_CREDIT=100
# What a vendor pays to be shown to one customer — immediately, or on accepting a fanned-out
# request. Below this balance a vendor is never presented as a paid lead.
VISIBILITY_FEE_CREDITS=100
# One-time grant to every successfully onboarded vendor, so a new profile can pay for leads.
ONBOARDING_GRANT_CREDITS=2000

# ── Conversation policy ──────────────────────────────────────────────────────
CONVERSATION_LOCK_TTL_MS=30000
CONVERSATION_LOCK_WAIT_MS=5000
WORKFLOW_IDLE_EXPIRY_MS=86400000
MAX_SUSPENDED_WORKFLOWS=10

# ── Taxonomy ─────────────────────────────────────────────────────────────────
# GS1 GPC dataset consumed by `npm run seed:taxonomy`. Supplied separately.
GS1_GPC_FILE=gs1_gpc.json

# ── Platform (TDR v1.3 Phase 1) ─────────────────────────────────────────────────────
# Development trace / Live Test API: GET /dev/registry, GET /dev/runs/:runId,
# GET /dev/conversations/:id/timeline, POST /dev/live-tests/runs (Overarching TDR §28).
# Unauthenticated by design at this stage (Final Lock §12); MUST be false in production.
DEV_TRACE_API_ENABLED=true
# Disables the durable outbox consumer worker (tests drive it manually).
OUTBOX_CONSUMER_DISABLED=false

# ── MCOS Turn Assembly (MCOS v4.4 §5A.3.2) ─────────────────────────────────────────────
# Inter-message accumulation window per channel; hard bounds per logical turn; queue worker.
TURN_QUIET_WINDOW_MS_WHATSAPP=2500
TURN_QUIET_WINDOW_MS_WEB=1200
TURN_QUIET_WINDOW_MS_DEFAULT=2000
TURN_MAX_ASSEMBLY_MS=15000
TURN_MAX_MESSAGE_COUNT=8
TURN_CLAIM_TTL_MS=300000
TURN_QUEUE_POLL_MS=1000
TURN_MAX_EXECUTION_ATTEMPTS=3
# P1 bounded model-assisted boundary classifier; deterministic signals decide by default.
TURN_ASSEMBLY_MODEL_CLASSIFIER_ENABLED=false

# ── Web Retrieval System (WRS 4.4) ─────────────────────────────────────────────
# Search provider behind SearchProviderPort. `tavily` (default) needs TAVILY_API_KEY; `none`
# makes WRS report PROVIDER_UNAVAILABLE so CSRE/Enrichment skip the evidence path honestly.
WRS_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# TAVILY_API_URL=https://api.tavily.com/search
WRS_MAX_QUERIES=4
WRS_MAX_RESULTS_PER_QUERY=6
WRS_TIMEOUT_MS=15000
