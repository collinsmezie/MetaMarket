{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "plugins": [],
    "assets": [
      {
        "include": "**/prompts/**/*.md",
        "watchAssets": true
      },
      {
        "include": "**/schemas/**/*.json",
        "watchAssets": true
      }
    ]
  }
}
